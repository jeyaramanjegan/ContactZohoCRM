<?xml version="1.0"?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">

    <table name="contact_zohocrm_sync_log" resource="default" engine="innodb" comment="Zoho CRM Sync Log">
        <column xsi:type="int" name="log_id" padding="10" unsigned="true" nullable="false" identity="true" comment="Log ID"/>
        <column xsi:type="int" name="customer_id" padding="10" unsigned="true" nullable="false" comment="Customer ID"/>
        <column xsi:type="varchar" name="action" length="50" nullable="false" comment="Action (create/update/delete)"/>
        <column xsi:type="varchar" name="status" length="20" nullable="false" default="pending" comment="Status (pending/success/error)"/>
        <column xsi:type="text" name="response" nullable="true" comment="API Response"/>
        <column xsi:type="text" name="error_message" nullable="true" comment="Error Message"/>
        <column xsi:type="varchar" name="zoho_id" length="50" nullable="true" comment="Zoho CRM Record ID"/>
        <column xsi:type="timestamp" name="created_at" nullable="false" default="CURRENT_TIMESTAMP" comment="Created At"/>
        <column xsi:type="timestamp" name="updated_at" nullable="true" comment="Updated At"/>
        <column xsi:type="smallint" name="retry_count" padding="3" unsigned="true" nullable="false" default="0" comment="Retry Count"/>

        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="log_id"/>
        </constraint>

        <constraint xsi:type="foreign" referenceId="CONTACT_ZOHOCRM_SYNC_LOG_CUSTOMER_ID_CUSTOMER_ENTITY_ENTITY_ID"
                    table="contact_zohocrm_sync_log" column="customer_id"
                    referenceTable="customer_entity" referenceColumn="entity_id"
                    onDelete="CASCADE"/>

        <index referenceId="CONTACT_ZOHOCRM_SYNC_LOG_CUSTOMER_ID" indexType="btree">
            <column name="customer_id"/>
        </index>

        <index referenceId="CONTACT_ZOHOCRM_SYNC_LOG_STATUS" indexType="btree">
            <column name="status"/>
        </index>

        <index referenceId="CONTACT_ZOHOCRM_SYNC_LOG_ACTION" indexType="btree">
            <column name="action"/>
        </index>

        <index referenceId="CONTACT_ZOHOCRM_SYNC_LOG_CREATED_AT" indexType="btree">
            <column name="created_at"/>
        </index>
    </table>
</schema>
